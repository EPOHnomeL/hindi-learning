# Copy to `.env.local` (gitignored). Most values are written automatically by
# Convex; you only set PUBLISH_SECRET by hand. The schema in src/env.js
# validates the public ones at build time.

# --- Convex (set automatically by `npx convex dev`) -------------------------
# Your deployment's URL; the reader and the teach CLI both read it.
# NEXT_PUBLIC_CONVEX_URL="https://<your-deployment>.convex.cloud"
# CONVEX_DEPLOYMENT="dev:<your-deployment>"

# --- Teach CLI (publish / review / reply) -----------------------------------
# A long random string. Set it in BOTH places so they match:
#   1) here in .env.local (so the CLI can send it), and
#   2) in the Convex deployment:  npx convex env set PUBLISH_SECRET <value>
# The publish/review/reply mutations reject any call whose secret doesn't match.
# PUBLISH_SECRET="change-me-to-a-long-random-string"
