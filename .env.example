# Copy to `.env.local` (gitignored). Most values are written automatically by
# Convex; you only set PUBLISH_SECRET by hand.

# --- Convex (set automatically by `npx convex dev`) -------------------------
# Your deployment's URL; the reader and the teach CLI both read it.
# NEXT_PUBLIC_CONVEX_URL="https://<your-deployment>.convex.cloud"
# CONVEX_DEPLOYMENT="dev:<your-deployment>"
# Prod deployment URL — the *:prod teach commands (publish:prod, review:prod,
# reply:prod) target this so the live site updates.
# CONVEX_PROD_URL="https://<your-prod>.convex.cloud"

# --- PostHog (browser analytics) ---------------------------------------------
# Set these public browser values in `.env.local`.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Teach CLI (publish / review / reply) -----------------------------------
# A long random string. Set it in BOTH places so they match:
#   1) here in .env.local (so the CLI can send it), and
#   2) in the Convex deployment:  npx convex env set PUBLISH_SECRET <value>
# The publish/review/reply mutations reject any call whose secret doesn't match.
# PUBLISH_SECRET="change-me-to-a-long-random-string"

# --- Invite emails (see .scratch/invite-emails) -----------------------------
# Sent via Resend. Set these in the CONVEX DEPLOYMENT (not Vercel — Convex
# functions can't read Vercel's env), e.g.  npx convex env set RESEND_API_KEY
# <value>  (add --prod to target the live deployment). If the first two are
# unset, the invite-email action logs and no-ops (the rest of the invite works).
#   RESEND_API_KEY     — Resend API key.
#   INVITE_FROM_EMAIL  — the From address, "Name <email>" or bare, on a domain
#                        VERIFIED in Resend. The project domain is my-course.app
#                        (Cloudflare), e.g. "Y-Knot Courses <invites@my-course.app>".
#   SITE_URL           — the ONE web-app origin, no trailing slash: serves both
#                        PayFast return/cancel URLs and invite-email links (a
#                        tenant course's links ride its own subdomain, derived
#                        as <slug>.<base> from this). Also a Convex env var, e.g.
#                        https://my-course.app. (Retired the separate APP_BASE_URL.)
