# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# grill-my-knowledge skill: source of truth is .agents/skills/; .claude/ is a local symlink
/.claude/skills/grill-my-knowledge

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# transient per-run teaching workspace: the Routine materialises each Topic from
# Convex into topics/<slug>/ at run time and never commits it (ADR 0009 — Convex
# is the source of truth). Untracked, so `git status` stays clean and the stop
# hook has nothing to deliberate over.
/topics/

# typescript
*.tsbuildinfo

# idea files
.idea

# scratch handbook page renders (scripts/render_pages.py output)
/scripts/_pages/

# agent handoff docs — transient session-to-session execution notes, not durable
# repo context (that lives in CLAUDE.md / docs/). Matches at any depth.
HANDOFF*.md
# Review output of scripts/st-za-rewrite.ts — regenerable, 114 HTML files.
/st-za-review/

# Rendered demo video (scripts/record-demo.mjs) — multi-MB binaries that are
# regenerable from the HTML page in one command, so the page is the source of
# record, not the .mp4.
/.tmp/

# Edition working copies (scripts/edition.ts pull). A local checkout of what the
# Hub already holds, one pull away from being regenerated, and often a whole
# course of HTML. The Hub is the source of truth (ADR 0009), not this directory.
/editions/

# PostHog wizard scratch (npx @posthog/wizard). Its cache and the integration
# skill it drops are regenerable by rerunning the wizard; 9f482c9 committed the
# 69-file cache by accident and this removes it (2026-09-03).
/.posthog-wizard-cache/
/.claude/skills/integration-nextjs-app-router/
/posthog-self-driving-report.md
