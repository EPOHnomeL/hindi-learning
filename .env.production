# Loaded by Vite for `pnpm build` only (production mode); committed (no secret).
# Local dev (`pnpm client`) does not load it, so the dev reader stays gate-free
# and the worker falls back to the dev user.
#
# The SAME-ORIGIN auth proxy path — the worker forwards /api/auth/* to the real
# neonauth service (see src/worker/index.ts) so the session cookie is
# first-party; pointing the SDK at the neonauth domain directly breaks because
# browsers drop its cookie as third-party.
VITE_NEON_AUTH_URL="/api/auth"
